<?xml version="1.0" encoding="utf-8"?>
<!-- Icone adaptativo (API 26+). O manifest continua apontando @mipmap/ic_launcher:
     o Android prefere este XML no Android 8+ e cai nos PNGs legados antes disso.
     background sangra ate a borda porque quem recorta e o launcher; foreground
     fica dentro da zona segura de 66dp. monochrome alimenta o icone tematico do
     Android 13+ — sem ele, o modo tematico cai no tratamento legado. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
